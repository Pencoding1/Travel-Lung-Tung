{
    "name": "Traveloka Tour Content Extraction",
    "baseSelector": "body", 
    "fields": [
        {
            "name": "Product_schema",
            "selector": "script[data-testid='product-schema']",
            "type": "text"
        },

        {
            "name": "highlights",
            "selector": "div[data-testid='ctr_highlightsContent']",
            "type": "text" 
        },

        {
            "name": "operating_hours",
            "selector": "div[data-testid='view_openingHoursPill']",
            "type": "text"
        },

        {
            "name": "location_summary",
            "selector": "div[data-testid='view_locationInfoPill']",
            "type": "text"
        },

        {
            "name": "ticket_list",
            "selector": "div:has(> div[data-testid='ctrItemCard'])", 
            "type": "list",
            "fields": [
                {
                    "name": "ticket_name",
                    "selector": "h3[data-testid='lblItemTitle']",
                    "type": "text"
                },
                {
                    "name": "ticket_description",
                    "selector": "div[data-testid='lblItemSubTitle']",
                    "type": "text"
                },
                {
                    "name": "current_price",
                    "selector": "div[aria-level='1']", 
                    "type": "text"
                },
                {
                    "name": "original_price",
                    "selector": "div[aria-level='1'] + div > div:first-child", 
                    "type": "text"
                }
            ]
        },

        {
            "name": "all_ticket_details",
            "selector": "#injected_modal_data_from_js",
            "type": "text"
        },

        {
            "name": "things_to_know",
            "selector": "div#iu-bn-cng-nn-bit",
            "type": "html"
        },

        {
            "name": "reviews_block",
            "selector": "div[data-testid='review-list-container']",
            "type": "text"
        },

        {
            "name": "FAQ_json",
            "selector": "#faq-section script[type='application/ld+json']",
            "type": "text"
        },

        {
            "name": "seo_article",
            "selector": "div#seo_article",
            "type": "html"
        }
    ]
}