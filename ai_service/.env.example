# AI service provider template (non-secret options only).
# Copy values into your real environment/.env. Never commit that file.
# The Gemini API key is read from GEMINI_API_KEY in the real environment and is
# intentionally not included here.

# Default provider. Existing behavior is retained unless this is explicitly set.
AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-pro

# Opt-in OpenCode CLI model transport. The CLI must already exist in the runtime;
# the production image does not include it. No tools/files/shell/network are
# enabled: each child gets a per-process agent with permission {'*': 'deny'}.
# AI_LLM_PROVIDER=opencode_cli
# AI_CLI_MODEL=aibox/ds/deepseek-flash
# AI_CLI_EXECUTABLE=
# AI_CLI_AGENT=travel-ai-cli-transport
# AI_CLI_TIMEOUT_SECONDS=120
# AI_CLI_MAX_OUTPUT_BYTES=2000000
# AI_CLI_MAX_PROMPT_CHARS=200000
# AI_CLI_MAX_ATTEMPTS=1
# AI_CLI_MAX_CONCURRENCY=2
# AI_CLI_PURE=true

# Opt-in synthetic-verification evidence. Unset = no raw conversation log.
# OpenCode still stores its own local CLI session.
# AI_CLI_EVIDENCE_DIR=

# Internal MCP endpoint consumed by this service.
MCP_SERVER_URL=http://poi_mcp:8001/sse
