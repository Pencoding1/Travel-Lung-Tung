    {
      "dot": "emerald",
      "title": "AI Orchestration (ai_service :8002)",
      "items": [
        "Intent router skips the tool loop for CHITCHAT",
        "execute_agent_loop runs up to 5 Gemini tool-calling turns",
        "generate_itinerary: resolve → explore → enrich → JSON synthesis",
        "Stateless; holds no database credentials"
      ]
    },
    {
      "dot": "violet",
      "title": "POI Domain — owns the location SoT",
      "items": [
        "REST :8000 plus the FastMCP :8001 tool gateway",
        "Memgraph is the sole SoT for POIs, tags and POI↔POI relations",
        "GraphHopper routes HCMC OSM for car, foot and bike",
        "CQRS: 500-record UNWIND chunks, canary + SSE progress"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence, Edge & Trust",
      "items": [
        "backend_service owns itineraries and stops in Firestore",
        "crawler_service feeds OTA batches through a service-token gate",
        "Only ai_service :8002 is public; ngrok fronts it on a fixed domain",
        "Secrets in .env / serviceAccountKey.json; CORS is '*'"
