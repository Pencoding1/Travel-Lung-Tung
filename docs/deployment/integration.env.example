# Interpolation template for docker-compose.integration.yaml (isolated stack).
#
# These are DUMMY, non-functional placeholders used only to render the
# integration compose file in structural checks:
#
#   docker compose -f docker-compose.integration.yaml \
#     --env-file docs/deployment/integration.env.example \
#     config --no-env-resolution --quiet
#
# This is NOT a production environment file. It contains no real credential.
# Copy it to an untracked file and replace the placeholders only if you intend
# to run the isolated stack; never commit real values.

# --- Integration-only auth/keys (required by the integration stack) ----------
# The SAME HS256 key variable feeds poi_api, poi_mcp and ai_service so tokens
# are valid across the isolated services. Values are echoed nowhere.
INTEGRATION_JWT_SECRET=replace_me_integration_jwt_secret
INTEGRATION_JWT_ALGORITHM=HS256

# --- Integration graph (required) --------------------------------------------
INTEGRATION_MEMGRAPH_USER=replace_me
INTEGRATION_MEMGRAPH_PASSWORD=replace_me

# --- Integration AI provider (required for /chat and /generate_itinerary) ----
INTEGRATION_GEMINI_API_KEY=replace_me

# --- Optional integration durable memory --------------------------------------
# Blank keeps durable profile memory OFF. A nonblank path MUST live under the
# mounted int_ai_memory volume, e.g. /var/lib/ai_memory/profiles.db.
INTEGRATION_MEMORY_DB_PATH=

# --- Optional Firestore in the isolated stack ---------------------------------
# Graph-only default. `true` additionally requires owner-managed credentials.
INTEGRATION_FIRESTORE_ENABLED=false

# --- backend_service draft storage (no interpolation needed) -------------------
# backend_service is wired with a LITERAL SQLite path inside its own
# int_backend_drafts volume (ITINERARY_STORAGE=sqlite,
# ITINERARY_SQLITE_PATH=/var/lib/backend_drafts/drafts.sqlite3). It is not
# interpolated from this template, uses no Firebase default, and never shares the
# optional AI durable-memory profile. The only value it needs from here is the
# shared INTEGRATION_JWT_SECRET (HS256) above.
