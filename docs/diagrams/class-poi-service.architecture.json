  "cards": [
    {
      "dot": "violet",
      "title": "Vì sao tách service khỏi repository",
      "items": [
        "Service chỉ biết giao diện, đổi store khác không phải sửa nghiệp vụ",
        "Unit of Work gom repository và transaction vào một ngữ cảnh, thoát khối with là chốt giao dịch",
        "BaseManagementService giữ một luồng duy nhất: kiểm tra dữ liệu, kiểm tra tồn tại, rồi mới ghi"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hai lối vào, một nghiệp vụ",
      "items": [
        "REST và MCP đều dùng lại POIManagementService, không có truy vấn song song nào khác",
        "Nhờ vậy quy tắc làm sạch dữ liệu chỉ tồn tại ở một chỗ",
        "MCP tự tạo UoW riêng nên không dùng chung transaction với REST"
      ]
    },
    {
      "dot": "rose",
      "title": "Chỗ còn hở",
      "items": [
        "IDocumentRepository có mặt nhưng chưa có đường nối vì lớp hiện thực còn rỗng",
        "SpatialUpdater chỉ chạy khi được gọi tay, không tự kích hoạt sau khi nạp POI",
        "Crawler là dịch vụ duy nhất gọi REST vào đây, phần còn lại đi qua MCP"
      ]
    }
  ]
