    {
      "dot": "cyan",
      "title": "Vì sao tách khám phá khỏi cào chi tiết",
      "items": [
        "Khám phá chỉ đọc metadata và điểm liên quan, rẻ hơn nhiều so với mở từng trang",
        "URL sau khi lọc được phân nhóm theo đoạn thứ tư của đường dẫn",
        "Mỗi nhóm có schema riêng nên thêm nguồn mới chỉ cần thêm thư mục schema và JS"
      ]
    },
    {
      "dot": "amber",
      "title": "Chiến lược chấm điểm",
      "items": [
        "VNStatistcalStrategy thay cách chấm của crawl4ai bằng tách từ tiếng Việt",
        "Nội dung được gột ảnh, URL và từ quảng cáo trước khi đếm tần suất từ",
        "VNEmbeddingStrategy mới là lớp rỗng, chọn embedding sẽ ném lỗi chưa hiện thực"
      ]
    },
    {
      "dot": "rose",
      "title": "Chỗ đang hở",
      "items": [
        "Cổng token so sánh với chuỗi test nằm thẳng trong mã nguồn",
        "Nhóm hotel cố tình ném exception nên bị bỏ qua toàn bộ",
        "Lớp Crawler gọi preprocessor, đường nối đó nằm trong __detail_crawl"
      ]
    }
