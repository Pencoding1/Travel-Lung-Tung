# Travel Vo Lo - local environment template.
#
# Copy this file to `.env` in the repository root and replace every
# `replace_me*` placeholder with a real value. Never commit a filled `.env`
# (it is git-ignored). This template is also used for dry structural
# validation: `docker compose --env-file .env.example config --no-env-resolution --quiet`.
#
# The placeholder values are intentionally non-functional.

# --- Memgraph (required) -----------------------------------------------------
# For local (non-container) development use 127.0.0.1; inside Compose the
# poi_api / poi_mcp services override the host to the `memgraph` service name.
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USER=replace_me
MEMGRAPH_PASSWORD=replace_me

# --- POI service auth (required) ---------------------------------------------
# POI_service fails fast at import time when JWT_SECRET is missing. The AI
# service reads the SAME HS256 key variable for authenticated memory. The
# secret value is never printed.
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ALGORITHM=HS256

# --- Firestore (optional) ----------------------------------------------------
# Graph-only is the default. `false` needs no Firebase package, key or network.
# Setting `true` requires owner-managed service-account credentials mounted at
# POI_service/secrets/serviceAccountKey.json and a reachable, verified project;
# an enabled dependency that cannot be verified refuses to start.
FIRESTORE_ENABLED=false

# --- Durable profile memory (optional) ---------------------------------------
# Blank/absent keeps durable profile memory OFF (in-memory only; nothing is
# persisted and no profile is stored). A nonblank path enables the
# authenticated SQLite profile store. Inside Compose the path MUST live under
# the mounted `ai_memory` volume (e.g. `/var/lib/ai_memory/profiles.db`);
# deleting that named volume is the only supported way to erase the data.
MEMORY_DB_PATH=

# --- AI service / Gemini (required for /chat and /generate_itinerary) --------
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-pro

# Internal MCP endpoint consumed by ai_service (`MCP_SERVER_URL`). It must match
# the SSE path actually served by POI_service/app/api/mcp/tools.py
# (FastMCP default transport path `/sse`).
MCP_SERVER_URL=http://poi_mcp:8001/sse

# --- Optional public tunnel (Compose profile: tunnel) ------------------------
# Leave these unset for local-only use. Both are required to enable the tunnel.
# NGROK_AUTHTOKEN=replace_me
# NGROK_DOMAIN=your-reserved-domain.ngrok.app

# --- Image overrides (optional) ----------------------------------------------
# Defaults keep the exact tags already referenced by docker-compose.yaml.
# Replace with `@sha256:<digest>` pins for reproducible runs.
# MEMGRAPH_IMAGE=memgraph/memgraph-mage:latest
# MEMGRAPH_LAB_IMAGE=memgraph/lab:latest
# GRAPHHOPPER_BASE_IMAGE=israelhikingmap/graphhopper:latest
# NGROK_IMAGE=ngrok/ngrok:latest

# --- Routing, AI Provider & Security overrides (optional) --------------------
# GRAPHHOPPER_PROFILES=car,foot
# AI_PROVIDER=gemini
# AIBOX_BASE_URL=http://127.0.0.1:8080/v1
# AIBOX_MODEL=travel-aibox-local
# ALLOWED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002
# CRAWLER_API_KEY=replace_me_crawler_api_key

